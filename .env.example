# =============================================================================
# Server / Backend Configuration
# =============================================================================
PORT=3000
NODE_ENV=production

# PostgreSQL Database Connection URL (e.g. from Render PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# JWT Authentication Secrets
JWT_SECRET=your-secure-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# Frontend Application URL (for CORS and email invite links)
# In production, set this to your Render Static Site URL (e.g. https://adse-frontend.onrender.com)
FRONTEND_URL=https://your-frontend.onrender.com

# Optional legacy alias for frontend/app URL
APP_URL=https://your-frontend.onrender.com

# Optional SMTP Settings (for production email delivery in server/mailer.js)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# =============================================================================
# Client / Frontend Configuration (Vite)
# =============================================================================
# Base URL for backend API requests (used by frontend during build/runtime)
# In production, set this to your Render Web Service URL (e.g. https://adse-api.onrender.com)
# In development, leave unset or http://localhost:3000
VITE_API_URL=https://your-backend-api.onrender.com
